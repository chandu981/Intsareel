# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
DJANGO_TIME_ZONE=UTC

# Database (leave empty for local SQLite)
DATABASE_URL=
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Static/media
STATIC_ROOT=staticfiles
MEDIA_ROOT=media

# Razorpay (test mode)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=replace-with-test-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-webhook-secret
RAZORPAY_CURRENCY=INR

# Media provider: demo or authorized
MEDIA_PROVIDER=authorized
AUTHORIZED_MEDIA_PROVIDER_ENABLED=True

# Download pricing and limits
DOWNLOAD_PRICE_PAISE=100
MAX_DOWNLOAD_FILE_BYTES=104857600
ARTIFACT_RETENTION_HOURS=24
MAX_RETRY_COUNT=3

# Processing
PROCESS_DOWNLOADS_SYNCHRONOUS=True
RUN_DOWNLOADS_IN_REQUEST_THREAD=True

# AI help chat (optional; local help answers are used when no key is set)
AI_CHAT_ENABLED=True
AI_CHAT_API_URL=https://api.openai.com/v1/chat/completions
AI_CHAT_API_KEY=
AI_CHAT_MODEL=gpt-4o-mini
AI_CHAT_TIMEOUT=15

# Security
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Rate limits
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_VALIDATE_URL=20/minute
RATE_LIMIT_CREATE_ORDER=10/minute
